# Bot token from the Discord Developer Portal
BOT_TOKEN=your_bot_token_here

# Comma-separated list of Discord user IDs allowed to use owner-only commands
OWNER_IDS=123456789012345678,987654321098765432

# Voice channel ID for $sing command (defaults to 1503585970014912718 if not set)
VOICE_CHANNEL_ID=1503585970014912718

# MongoDB Atlas connection URI (used by $mongo command health check)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/database?retryWrites=true&w=majority
